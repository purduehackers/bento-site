---
const canonical = new URL(Astro.url.pathname, 'https://bento.purduehackers.com');
const description = 'BENTO: 15 lightning talks from Purdue Hackers on software, hardware, design, and unusual interests. Explore speakers, talk summaries, and the April 11, 2026 recording.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>BENTO — talks & ideas from Purdue Hackers</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="BENTO — talks & ideas from Purdue Hackers" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link
      rel="preload"
      href="/PixelHackers.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/PolySans-Relax.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>

<style>
  main { width: 100%; }
  html,
  body {
    position: relative;
    margin: 0;
    width: 100%;
    min-height: 100%;
    background-color: #fffae500;
  }

  /* Desktop only: center the content and clip overflow */
  @media screen and (min-width: 501px) {
    html,
    body {
      /*overflow: hidden;*/
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
    }
  }

  /* Mobile: let the page scroll naturally */
  @media screen and (max-width: 500px) {
    html,
    body {
      overflow-y: auto;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }
    body {
      padding-bottom: 8lh;
    }
  }

  body:hover {
    cursor: url(/./cursors/pointer.png), auto;
  }
</style>
