<div id="loading-overlay">
  <slot name="hi" />
</div>

<style>
  #loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  #loading-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>

<noscript><style>#loading-overlay { display: none; }</style></noscript>

<script is:inline>
  function hideLoader() {
    const overlay = document.getElementById("loading-overlay");
    if (!overlay) return;
    overlay.classList.add("hidden");

    // Remove from DOM after fade completes
    overlay.addEventListener("transitionend", () => overlay.remove(), { once: true });
    // A disabled transition (for example reduced motion) may not emit an event.
    window.setTimeout(() => overlay.remove(), 400);
  }
  // The text is ready with the document. Remote scripts and images must not
  // keep the talk archive behind a full-screen loading overlay.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", hideLoader, { once: true });
  } else {
    hideLoader();
  }
</script>
